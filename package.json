{
  "name": "hr-automation",
  "version": "0.1.0",
  "description": "UCPath HR automation for UCSD — Playwright-driven onboarding, separations, EID lookups, work-study updates, Kronos reports, and emergency-contact fills composed from per-system drivers and a small workflow kernel.",
  "private": true,
  "type": "module",
  "license": "ISC",
  "scripts": {
    "test-login": "tsx --env-file=.env src/cli.ts test-login",
    "test-login:fresh": "tsx --env-file=.env src/cli.ts test-login --fresh",
    "extract": "tsx --env-file=.env src/cli.ts extract",
    "onboarding": "tsx --env-file=.env src/cli.ts onboarding",
    "onboarding:stop": "tsx --env-file=.env src/cli.ts daemon-stop onboarding",
    "separation": "tsx --env-file=.env src/cli.ts separation",
    "separation:stop": "tsx --env-file=.env src/cli.ts daemon-stop separations",
    "work-study": "tsx --env-file=.env src/cli.ts work-study",
    "work-study:stop": "tsx --env-file=.env src/cli.ts daemon-stop work-study",
    "oath-signature": "tsx --env-file=.env src/cli.ts oath-signature",
    "oath-signature:stop": "tsx --env-file=.env src/cli.ts daemon-stop oath-signature",
    "oath-upload": "tsx --env-file=.env src/cli.ts oath-upload",
    "oath-upload:stop": "tsx --env-file=.env src/cli.ts daemon-stop oath-upload",
    "eid-lookup": "tsx --env-file=.env src/cli.ts eid-lookup",
    "eid-lookup:stop": "tsx --env-file=.env src/cli.ts daemon-stop eid-lookup",
    "active-check": "tsx --env-file=.env src/cli.ts active-check",
    "active-check:stop": "tsx --env-file=.env src/cli.ts daemon-stop active-check",
    "kronos": "tsx --env-file=.env src/cli.ts kronos",
    "emergency-contact": "tsx --env-file=.env src/cli.ts emergency-contact",
    "emergency-contact:stop": "tsx --env-file=.env src/cli.ts daemon-stop emergency-contact",
    "dashboard": "tsx --env-file=.env src/cli.ts dashboard",
    "dashboard:prod": "tsx --env-file=.env src/cli.ts dashboard --prod",
    "dashboard:tunneled": "./scripts/dashboard-tunneled.sh",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "setup": "tsx --env-file=.env src/scripts/ops/setup.ts",
    "setup:telegram": "tsx --env-file=.env src/scripts/ops/setup.ts --telegram",
    "clean:tracker": "tsx src/scripts/ops/clean-tracker.ts",
    "schemas:export": "tsx --env-file=.env src/scripts/codegen/export-schemas.ts",
    "selectors:catalog": "tsx src/scripts/selectors/catalog.ts",
    "selector:search": "tsx src/scripts/selectors/search.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "node scripts/run-tests.mjs tests",
    "test:architecture": "node scripts/run-tests.mjs tests/unit/architecture"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@heroui/calendar": "^2.2.32",
    "@heroui/react": "^3.0.2",
    "@heroui/styles": "^3.0.2",
    "@hono/node-server": "^2.0.1",
    "@internationalized/date": "^3.12.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "hono": "^4.12.16",
    "lucide-react": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.8",
    "vite-plugin-singlefile": "^2.3.2"
  }
}
