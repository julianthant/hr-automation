UCPATH_USER_ID=your-ucsd-user-id
UCPATH_PASSWORD=your-ucsd-password
TIMEKEEPER_NAME=your-timekeeper-name

# Annual dates (optional — override when fiscal year rolls)
# Format matches the hardcoded defaults in src/config.ts (MM/DD/YYYY or M/D/YYYY).
# ANNUAL_DATES_END=06/30/2027
# KRONOS_DEFAULT_END_DATE=2/1/2027
# KRONOS_DEFAULT_START_DATE=1/1/2017

# SharePoint spreadsheet URLs — dashboard queue-header "Download" dropdown.
#
# The registry in src/workflows/sharepoint-download/registry.ts maps each
# dropdown option to an env var here. Unset vars render the option disabled
# with an "unset" hint; set vars save into src/data/<timestamp>-<filename>.xlsx
# on click. Add one line per spreadsheet as the registry grows.
#
# ONBOARDING_ROSTER_URL=https://ucsdcloud.sharepoint.com/.../onboarding.xlsx

# Telegram bot — Duo MFA notifications to your phone.
#
# When both vars are set, every Duo prompt fires a Telegram DM with the
# website + workflow + runId so you can approve from your phone when away
# from the computer. Either var unset disables the integration silently.
# Run `npm run setup:telegram` for an interactive wizard that creates the
# bot via @BotFather and auto-discovers your chat_id.
#
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Duo SMS passcode via iMessage (macOS only) — hands-off Duo MFA.
#
# When set to 1 on the Mac running the automation, Duo logins select Duo's
# "Text message passcode" option and auto-submit the code read from the
# Messages app (chat.db) — no phone interaction. Requires:
#   • Text Message Forwarding enabled to this Mac (on the iPhone: Settings →
#     Messages → Text Message Forwarding).
#   • Full Disk Access granted to the app that launches the automation
#     (System Settings → Privacy & Security → Full Disk Access); relaunch the
#     app after granting. Run `npm run setup` to verify access.
# Any miss (code not read in time, prompt change) falls back automatically to
# approving the Duo push on your phone. Unset / non-macOS → disabled.
#
# HR_AUTOMATION_DUO_SMS=1
