# Most of the values below can ALSO be set from the dashboard Settings page
# (navbar gear), which writes config/settings.json (gitignored). Precedence is
# env var > config/settings.json > built-in default, so anything set here always
# wins over the Settings page.

UCPATH_USER_ID=your-ucsd-user-id
UCPATH_PASSWORD=your-ucsd-password

# Optional: Tracker I-9 / I9 Complete credentials when they differ from UCPath.
# Leave both unset to reuse UCPATH_USER_ID/UCPATH_PASSWORD.
# I9_USER_ID=your-i9-email@ucsd.edu
# I9_PASSWORD=your-i9-password

TIMEKEEPER_NAME=your-timekeeper-name

# Annual dates (optional — override when fiscal year rolls)
# Format matches the hardcoded defaults in src/config.ts (MM/DD/YYYY or M/D/YYYY).
# ANNUAL_DATES_END=06/30/2027
# KRONOS_DEFAULT_END_DATE=2/1/2027
# KRONOS_DEFAULT_START_DATE=1/1/2017

# SharePoint spreadsheet URLs — dashboard queue-header "Download" dropdown.
#
# The registry in src/workflows/sharepoint-download/registry.ts maps each
# dropdown option to an env var here. Unset vars render the option disabled
# with an "unset" hint; set vars save into src/data/<timestamp>-<filename>.xlsx
# on click. Add one line per spreadsheet as the registry grows.
#
# ONBOARDING_ROSTER_URL=https://ucsdcloud.sharepoint.com/.../onboarding.xlsx

# Hands-off Duo MFA via a WebAuthn virtual authenticator (Chromium only).
#
# When set to 1, login flows approve Duo automatically using a credential
# enrolled once as an independent Duo security key — no phone push. Enroll the
# credential first with `npm run duo:webauthn:enroll` (writes the gitignored
# .auth/duo-webauthn.json), then set this flag. Any failure (missing credential,
# factor not offered, ceremony rejected) silently falls back to manual phone
# approval, so it is safe to leave on. Unset (or any value other than 1)
# disables it. See src/infra/auth/duo-webauthn.ts.
#
# HR_AUTOMATION_DUO_WEBAUTHN=1

# Debug screenshot capture (default OFF).
# Set to 1 to enable debugScreenshot() calls in hot paths (searchPerson,
# login flows, Kronos navigation). Off by default to avoid 4+ fullPage PNG
# writes per searchPerson call. Operator-audit screenshots (ctx.screenshot
# kind='form'/'error') are always written regardless of this flag.
#
# DEBUG_SCREENSHOTS=1

# Performance / OCR tuning — normally set from the dashboard Settings page, but
# overridable here (env wins). Defaults shown.
# HRAUTO_NAVIGATION_RETRIES=10                    # nav refresh attempts before failing a run
# HRAUTO_SEPARATION_TERMINATION_WINDOW_DAYS=14    # prior-TER reuse window (days)
# OCR_SECOND_OPINION_MAX=5
# OCR_PAGE_MAX_WAIT_MS=120000
# OCR_PAGE_CONCURRENCY=                            # blank = Auto (vision-pool size)
# OCR_DISAMBIG_CONCURRENCY=4
# OCR_SUGGEST_CONCURRENCY=4
