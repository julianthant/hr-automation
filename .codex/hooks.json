{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/julianhein/Projects/hr-automation/.codex/hooks/warn-large-files.sh'"
          },
          {
            "type": "command",
            "command": "bash '/Users/julianhein/Projects/hr-automation/.codex/hooks/scan-secrets.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // \"\"'); echo \"$f\" | grep -qE '/src/.*\\.ts$' || exit 0; npm run typecheck 2>&1 | tail -50",
            "timeout": 60,
            "statusMessage": "Running typecheck..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"/Users/julianhein/.agents/skills/impeccable/scripts/hook.mjs\" ] || node \"/Users/julianhein/.agents/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"/Users/julianhein/.agents/skills/impeccable/scripts/hook.mjs\" ] || node \"/Users/julianhein/.agents/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
