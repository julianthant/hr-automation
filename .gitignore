# Environment variables / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Auth session state
.auth/

# Claude Code
.claude/

# Superpowers brainstorm mockups
.superpowers/

# Dashboard log
.dashboard.log

# Playwright CLI
.playwright-cli/

# Playwright MCP (snapshots, console logs)
.playwright-mcp/

# Superpowers plans / review-request scratch docs
docs/superpowers/

# Tracker data (local runtime)
.tracker/

# Excel tracking files
*.xlsx

# Downloaded rosters + captured screenshots (local-only, PII-adjacent).
# Directory shells are tracked via .gitkeep so runtime writers find the targets.
src/data/*
!src/data/.gitkeep
!src/data/screenshots/
src/data/screenshots/*
!src/data/screenshots/.gitkeep
!src/data/sharepoint/
src/data/sharepoint/*
!src/data/sharepoint/.gitkeep

# Legacy screenshot location — kept for cleanup on older working trees.
.screenshots/

# Generated artifacts. Directory shells/docs may be tracked; generated outputs
# are re-created by scripts/tests.
generated/schemas/*.schema.json
generated/pathfinder/
generated/.tracker-*/
generated/.e2e-screenshots/

# OS
.DS_Store
Thumbs.db

# Scratch files (chat references, not meant to be committed)
/image.png
/notes.md
.ocr-cache/
.worktrees/
