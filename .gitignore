# Environment variables / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Auth session state
.auth/

# Claude Code
.claude/

# Superpowers brainstorm mockups
.superpowers/

# Dashboard log
.dashboard.log

# Playwright CLI
.playwright-cli/

# Playwright MCP (snapshots, console logs)
.playwright-mcp/

# Docs: ignore ad hoc docs by default, but keep canonical workflow + engineering docs trackable.
docs/*
!docs/README.md
!docs/workflow/
!docs/workflow/**
!docs/engineering/
!docs/engineering/**

# Tracker data (local runtime)
.tracker/
.screenshots/

# Excel tracking files
*.xlsx

# Downloaded rosters + captured screenshots now live under .tracker/
# (.tracker/sharepoint, .tracker/rosters, .tracker/screenshots) — covered by
# the .tracker/ rule above. Runtime writers mkdir their targets on demand.

# Generated artifacts. Directory shells/docs may be tracked; generated outputs
# are re-created by scripts/tests.
generated/schemas/*.schema.json
generated/pathfinder/
generated/.tracker-*/
generated/.e2e-screenshots/
# e2e-test harness scratch scripts (regenerated each run by the e2e-test skill)
generated/e2e-*
generated/build-e2e-report.py

# OS
.DS_Store
Thumbs.db

# Scratch files (chat references, not meant to be committed)
/image.png
/notes.md
.worktrees/

# Local oath/OCR PDF fixtures at repo root — operator test artifacts, may contain PII.
tests/data/*.pdf
# e2e roster identities sidecar (PII — real names+EIDs for make-e2e-roster.mjs)
tests/data/e2e-roster-identities.json
# AI e2e test run artifacts (manifests, issue ledgers, reports)
.e2e/
