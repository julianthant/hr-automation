# Environment variables / secrets
.env
.env.*
!.env.example

# Operator settings written by the dashboard Settings page — machine-specific
# operator state (like .env). The other config/ files (workflow-presentation,
# workflow-design) stay tracked; only this one is ignored.
config/settings.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Auth session state
.auth/

# Claude Code
.claude/

# Superpowers brainstorm mockups
.superpowers/

# Dashboard log
.dashboard.log

# Playwright CLI
.playwright-cli/

# Playwright MCP (snapshots, console logs)
.playwright-mcp/

# Playwright CLI config generated by `npm run sel:browser` (machine-specific abs paths)
.playwright/

# Duo Autopilot extension — NEVER commit the enrolled WebAuthn private keys
duo-autopilot/credentials/
duo-autopilot/node_modules/

# Docs: ignore ad hoc docs by default, but keep canonical workflow + engineering docs trackable.
docs/*
!docs/README.md
!docs/workflow/
!docs/workflow/**
!docs/engineering/
!docs/engineering/**

# Tracker data (local runtime)
.tracker/
.screenshots/

# Excel tracking files
*.xlsx

# Downloaded rosters + captured screenshots now live under .tracker/
# (.tracker/sharepoint, .tracker/rosters, .tracker/screenshots) — covered by
# the .tracker/ rule above. Runtime writers mkdir their targets on demand.

# Generated artifacts. Directory shells/docs may be tracked; generated outputs
# are re-created by scripts/tests. See generated/README.md for the layout.
generated/schemas/*.schema.json
generated/pathfinder/
generated/reports/
# All run-scratch lives in dot-dirs under generated/ (per generated/README.md) —
# ignore every one of them with a single catch-all. Currently:
#   .e2e/                  e2e run artifacts (app tracker + harness manifests/reports)
#   .tests/                unit-test tracker output (tracker/log/log-validator)
#   .dashboard-preview/    seed-session-fixture.ts dashboard fixture
#   .duo-soak/             Duo Autopilot soak-run logs
#   .screenshot-verify/    selector verification screenshots
#   .screenshot-verify-live/  live-workflow verification shots + tracker
generated/.*/

# OS
.DS_Store
Thumbs.db

# Scratch files (chat references, not meant to be committed)
/image.png
/notes.md
/duo.yaml
.worktrees/

# Local oath/OCR PDF fixtures at repo root — operator test artifacts, may contain PII.
tests/data/*.pdf
# e2e roster identities sidecar (PII — real names+EIDs for make-e2e-roster.mjs)
tests/data/e2e-roster-identities.json
