# Real operator data, restored only on the operator's machine. Git ignores it;
# the pre-commit scanner does not special-case it.
/private/

# Environment variables / secrets
.env
.env.*
!.env.example

# Operator settings written by the dashboard Settings page — machine-specific
# operator state (like .env). The other config/ files (workflow-presentation,
# workflow-design) stay tracked; only this one is ignored.
config/settings.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.venv/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Auth session state
.auth/

# Claude Code
.claude/

# Superpowers brainstorm mockups
.superpowers/

# Dashboard log
.dashboard.log

# Playwright CLI
.playwright-cli/

# Playwright MCP (snapshots, console logs)
.playwright-mcp/

# Playwright CLI config generated by `npm run sel:browser` (machine-specific abs paths)
.playwright/

# Duo Autopilot extension — NEVER commit the enrolled WebAuthn private keys
duo-autopilot/credentials/
duo-autopilot/node_modules/

# Docs: ignore ad hoc docs by default, but keep canonical workflow + engineering docs trackable.
docs/*
!docs/README.md
!docs/workflow/
!docs/workflow/**
!docs/engineering/
!docs/engineering/**
!docs/rebuild/
!docs/rebuild/**
!docs/superpowers/
!docs/superpowers/**

# Tracker data (local runtime)
.tracker/
.screenshots/

# Excel tracking files
*.xlsx

# Downloaded rosters + captured screenshots now live under .tracker/
# (.tracker/sharepoint, .tracker/rosters, .tracker/screenshots) — covered by
# the .tracker/ rule above. Runtime writers mkdir their targets on demand.

# Generated artifacts. Only the README shells are tracked. Run output, schema
# exports, and dated batch receipts (CRM checks, Kuali runs, imports) stay local.
# See generated/README.md.
generated/*
!generated/README.md
!generated/schemas/
generated/schemas/*
!generated/schemas/README.md

# OS
.DS_Store
Thumbs.db

# Scratch files (chat references, not meant to be committed)
/image.png
/notes.md
/duo.yaml
.worktrees/

# Operator data tree — fixtures + download outputs (may contain PII).
data/documents/*.pdf
data/documents/e2e-roster-identities.json
data/documents/e2e-fixture-roster.xlsx
data/downloads/
data/reports/
data/onboarding/
data/i9/
# Rosters (Action History, SharePoint downloads) — keep directory, ignore contents.
data/rosters/*
!data/rosters/.gitkeep

# Local outputs & scratch directories
/outputs/
/tmp/

